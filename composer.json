{
    "name": "phauthentic/symfony-aop",
    "description": "Symfony bundle for phauthentic/aop: tagged aspects, compile-time proxy weaving and a debug:aop command.",
    "type": "symfony-bundle",
    "license": "MIT",
    "authors": [
        {
            "name": "Florian Krämer"
        }
    ],
    "require": {
        "php": ">=8.3",
        "composer-runtime-api": "^2.0",
        "phauthentic/aop": "dev-main",
        "symfony/config": "^7.2 || ^8.0",
        "symfony/console": "^7.2 || ^8.0",
        "symfony/dependency-injection": "^7.2 || ^8.0",
        "symfony/http-kernel": "^7.2 || ^8.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan": "^2.3",
        "phpunit/phpunit": "^12.0",
        "symfony/event-dispatcher": "^7.2 || ^8.0",
        "symfony/framework-bundle": "^7.2 || ^8.0",
        "symfony/var-exporter": "^7.2 || ^8.0"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/Phauthentic/aop.git"
        }
    ],
    "autoload": {
        "psr-4": {
            "Phauthentic\\AOP\\Symfony\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Phauthentic\\AOP\\Symfony\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "test": "phpunit",
        "stan": "phpstan analyse --memory-limit=1G",
        "cs": "php-cs-fixer fix --dry-run --diff",
        "cs-fix": "php-cs-fixer fix",
        "coverage": [
            "@putenv XDEBUG_MODE=coverage",
            "phpunit --coverage-clover=var/coverage/clover.xml",
            "php tools/coverage-check.php var/coverage/clover.xml 85"
        ],
        "check": [
            "@cs",
            "@stan",
            "@coverage"
        ]
    }
}
